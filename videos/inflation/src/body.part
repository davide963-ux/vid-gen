    </style>
  </head>
  <body>
    <div id="root" data-composition-id="main" data-start="0" data-duration="__TOTAL__" data-width="1080" data-height="1920">
      <div id="stage" class="clip" data-start="0" data-duration="__TOTAL__" data-track-index="0">
        <div id="dyn"></div>

        <!-- L1 hook -->
        <div id="a0" class="abs" style="left:0;top:210px;width:1080px;text-align:center"><span class="chip">About money</span></div>
        <div id="a1" class="abs big" style="left:0;top:320px;width:1080px;font-size:132px">YOU PROBABLY</div>
        <div id="a2" class="abs big bl" style="left:0;top:460px;width:1080px;font-size:132px">DIDN'T KNOW</div>
        <img id="eEx" class="abs" src="assets/img/emote_exclamation.png" style="left:790px;top:300px;width:160px" />

        <!-- L2 same amount -->
        <div id="today" class="abs card" style="left:60px;top:900px;width:380px;height:270px;text-align:center"><div class="tag" style="margin-top:36px;font-size:28px">Today</div><div class="big bl" style="font-size:118px;margin-top:14px">$100</div></div>
        <div id="arrow" class="lot" style="left:440px;top:980px;width:200px;height:112px"></div>
        <div id="later" class="abs card" style="left:640px;top:900px;width:380px;height:270px;text-align:center"><div class="tag" style="margin-top:36px;font-size:28px">Years later</div><div class="big bl" style="font-size:118px;margin-top:14px">$100</div></div>

        <!-- L3 poorer -->
        <img id="iDown" class="abs" src="assets/img/ph-trend-down-bold.svg" style="left:410px;top:900px;width:260px" />
        <div id="chip3" class="abs" style="left:0;top:1200px;width:1080px;text-align:center"><span class="chip">Same number, less value</span></div>

        <!-- L4 strange -->
        <div id="k1" class="abs big" style="left:0;top:900px;width:1080px;font-size:180px">SOUNDS</div>
        <div id="k2" class="abs big bl" style="left:0;top:1090px;width:1080px;font-size:180px">STRANGE?</div>
        <img id="iQ" class="abs" src="assets/img/ph-question-bold.svg" style="left:870px;top:900px;width:130px" />

        <!-- L5 imagine -->
        <div id="money" class="lot" style="left:330px;top:900px;width:420px;height:330px"></div>

        <!-- L6 / L7 / L10 meals -->
        <div id="ptag" class="abs" style="left:0;top:790px;width:1080px;text-align:center"><span class="chip" style="font-size:38px">10 meals cost <span id="pv">$100</span></span></div>
        <div id="meals"></div>
        <div id="chip10" class="abs" style="left:0;top:790px;width:1080px;text-align:center"><span class="chip" style="font-size:38px">$100 now buys about 8</span></div>

        <!-- L8 / L9 -->
        <img id="iOk" class="abs" src="assets/img/ph-check-circle-bold.svg" style="left:410px;top:900px;width:260px" />
        <div id="chip8" class="abs" style="left:0;top:1200px;width:1080px;text-align:center"><span class="chip">Still $100</span></div>
        <img id="iNo" class="abs" src="assets/img/ph-prohibit-bold.svg" style="left:410px;top:900px;width:260px" />
        <div id="chip9" class="abs" style="left:0;top:1200px;width:1080px;text-align:center"><span class="chip">Nothing taken</span></div>

        <!-- L11 inflation -->
        <img id="iUp" class="abs" src="assets/img/ph-trend-up-bold.svg" style="left:390px;top:640px;width:300px" />
        <div id="chip11" class="abs" style="left:0;top:1010px;width:1080px;text-align:center"><span class="chip">Prices rising over time</span></div>

        <!-- L12 purchasing power -->
        <div id="chart" class="abs card" style="left:60px;top:480px;width:610px;height:560px;padding:30px 36px">
          <div class="tag" style="text-align:left;font-size:28px">Prices</div>
          <svg viewBox="0 0 520 400" width="530" height="430" style="margin-top:6px"><path d="M20 20 L20 370 L510 370" fill="none" stroke="#111" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/><path id="cline" d="M30 340 C 130 322, 230 270, 310 200 S 440 90, 500 36" fill="none" stroke="#1e2bfa" stroke-width="12" stroke-linecap="round" style="stroke-dasharray:700;stroke-dashoffset:700"/></svg>
        </div>
        <div id="coinc" class="abs card" style="left:710px;top:480px;width:310px;height:560px;text-align:center"><div class="tag" style="margin-top:30px;font-size:26px">Buying power</div><div style="position:relative;width:230px;height:230px;margin:80px auto 0"><div id="coin" style="width:230px;height:230px;border-radius:50%;border:12px solid #1e2bfa;background:#fff;text-align:center;line-height:206px;font-weight:700;font-size:130px;color:#1e2bfa">$1</div></div></div>

        <!-- L14 what it buys -->
        <div id="shop"></div>

        <!-- L15 value eaten -->
        <div id="donut" class="abs" style="left:300px;top:500px;width:480px;height:480px;border-radius:50%;background:conic-gradient(#1e2bfa 0 100%, rgba(30,43,250,0.12) 100% 100%)"><div style="position:absolute;left:70px;top:70px;width:340px;height:340px;border-radius:50%;background:#fdfae7;text-align:center;line-height:330px;font-weight:700;font-size:200px;color:#1e2bfa">$</div></div>
        <div id="chip15" class="abs" style="left:0;top:1040px;width:1080px;text-align:center"><span class="chip">Value of your money</span></div>

        <!-- L16 / L17 bars -->
        <div id="bl1" class="abs tag" style="left:110px;top:500px;width:860px;text-align:left;font-size:28px">Your balance</div>
        <div id="bb1" class="abs" style="left:110px;top:548px;width:860px;height:100px;border-radius:20px;background:#111;color:#fdfae7;font-weight:700;font-size:58px;line-height:100px;padding-left:34px;letter-spacing:-0.02em">$100</div>
        <div id="bl2" class="abs tag" style="left:110px;top:700px;width:860px;text-align:left;font-size:28px">Your buying power</div>
        <div id="bb2" class="abs" style="left:110px;top:748px;width:860px;height:100px;border-radius:20px;background:#1e2bfa;color:#fdfae7;font-weight:700;font-size:58px;line-height:100px;padding-left:34px;letter-spacing:-0.02em;overflow:hidden;white-space:nowrap">Buys 10 meals</div>

        <!-- L18 final -->
        <div id="f1" class="abs big" style="left:0;top:330px;width:1080px;font-size:112px">YOU DIDN'T KNOW</div>
        <div id="f2" class="abs big bl" style="left:0;top:460px;width:1080px;font-size:100px">THAT ABOUT MONEY.</div>
        <div id="conf" class="lot" style="left:0;top:80px;width:1080px;height:1080px"></div>

        <div id="caps"></div>
        <div id="prog"></div>
      </div>
    </div>

    <script>
      const WORDS = __WORDS__;
      window.__timelines = window.__timelines || {};
      const hash = (i) => { const x = Math.sin(i * 127.1 + 311.7) * 43758.5453; return x - Math.floor(x); };
      const wd = (l, k) => WORDS.filter((w) => w.line === l)[k].s;
      const tl = gsap.timeline({ paused: true });
      const E = 'power3.out', IO = 'power2.inOut';
      const $ = (s) => document.querySelector(s);
      const R = (el, t, from, to) => tl.fromTo(el, Object.assign({ opacity: 0, y: 28 }, from || {}), Object.assign({ opacity: 1, y: 0, duration: 0.55, ease: E, immediateRender: false }, to || {}), t);
      const X = (el, t, d) => tl.to(el, { opacity: 0, duration: d || 0.25, ease: 'none' }, t);
      const POP = { scale: 0.6, y: 24 }, POPTO = { scale: 1, duration: 0.5 };
      const STRIKE = (sel, t) => tl.fromTo(sel, { scaleX: 0 }, { scaleX: 1, duration: 0.3, ease: 'power2.out', immediateRender: false }, t);
      const fmt = (v) => '$' + Math.round(v);

      // ---- headers: a small tag line and a big line
      const dyn = $('#dyn');
      const hd = (id, tag, big, size, cls) => dyn.insertAdjacentHTML('beforeend', `<div id="${id}t" class="abs tag" style="left:0;top:225px;width:1080px">${tag}</div><div id="${id}b" class="abs big ${cls || ''}" style="left:0;top:275px;width:1080px;font-size:${size}px">${big}</div>`);
      hd('h2', 'The exact same amount', '$100 = $100', 150);
      hd('h3', 'And still become', 'POORER', 160, 'bl');
      hd('h5', 'Imagine you have', '$100', 160, 'bl');
      hd('h6', 'Today, that $100 might buy', '10 MEALS', 160, 'bl');
      hd('h7', 'A few years of rising prices', 'PRICES RISE', 140);
      hd('h7c', 'Those same ten meals cost', 'NOW $120', 150, 'bl');
      hd('h8', 'Your $100', "DIDN'T DISAPPEAR", 118, 'bl');
      hd('h9', 'Nobody took', 'ANY MONEY', 160);
      hd('h10', 'But now it buys', 'LESS', 160, 'bl');
      hd('h11', 'That is what', 'INFLATION', 190, 'bl');
      hd('h12', 'Prices rise, each dollar has', 'LESS BUYING POWER', 96, 'bl');
      hd('h13', "More money doesn't always mean", 'GETTING RICHER', 124);
      hd('h14', 'What really matters is', 'WHAT IT CAN BUY', 110, 'bl');
      hd('h15', 'Inflation quietly eats away', 'AT ITS VALUE', 140, 'bl');
      hd('h16', 'Your balance can stay', 'EXACTLY THE SAME', 112);
      hd('h17', 'While your buying power', 'GETS SMALLER', 140, 'bl');
      $('#h13b').insertAdjacentHTML('beforeend', '<div id="h13s" class="strike" style="left:150px;top:60px;width:780px"></div>');
      // positions of tags for the scenes with no account card (content sits higher)
      ['h11'].forEach((p) => { $('#' + p + 't').style.top = '240px'; $('#' + p + 'b').style.top = '292px'; });

      // ---- account cards
      const mkAcct = (id, bal) => `<div id="${id}" class="abs card" style="left:130px;top:470px;width:820px;height:300px;padding:34px 50px" data-layout-allow-overlap><div style="display:flex;align-items:center;gap:18px"><img src="assets/img/ph-bank-bold.svg" style="width:50px" /><div class="tag" style="font-size:28px">Your bank account</div></div><div class="tag" style="text-align:left;color:#6b6b6b;margin-top:26px;font-size:24px">Balance</div><div id="${id}b" class="big" style="text-align:left;font-size:120px;line-height:1.15;margin-top:2px">$${bal}</div></div>`;
      dyn.insertAdjacentHTML('beforeend', mkAcct('acct', 100) + mkAcct('acct2', 100));

      // ---- meal grid (10), shop cards (4)
      $('#meals').innerHTML = Array.from({ length: 10 }, (_, i) => `<div id="m${i}" class="abs card" style="left:${51 + (i % 5) * 202}px;top:${880 + Math.floor(i / 5) * 200}px;width:170px;height:170px;text-align:center"><img src="assets/img/ph-fork-knife-bold.svg" style="width:92px;margin-top:38px" /></div>`).join('');
      const SH = [['ph-coffee-bold', 'Coffee'], ['ph-pizza-bold', 'Lunch'], ['ph-t-shirt-bold', 'Clothes'], ['ph-device-mobile-bold', 'Phone']];
      $('#shop').innerHTML = SH.map((s, i) => `<div id="sh${i}" class="abs card" style="left:${60 + (i % 2) * 520}px;top:${500 + Math.floor(i / 2) * 340}px;width:440px;height:300px;text-align:center"><img src="assets/img/${s[0]}.svg" style="width:130px;margin-top:50px" /><div class="tag" style="margin-top:22px;font-size:34px">${s[1]}</div></div>`).join('');

      // ---- L1 hook (account card peeks in below)
      R('#a0', 0.3); R('#a1', 0.3, {}, { duration: 0.6 }); R('#a2', 0.92, {}, { duration: 0.6 }); R('#eEx', 2.2, { scale: 0.3 }, POPTO);
      ['#a0', '#a1', '#a2', '#eEx'].forEach((s) => X(s, 3.0));
      tl.fromTo('#acct', { opacity: 0, y: 560, rotation: -7, scale: 0.9 }, { opacity: 1, y: 430, rotation: -4, scale: 0.9, duration: 0.9, ease: E, immediateRender: false }, 1.0);
      // ---- L2 same amount (3.25 - 6.8)
      tl.to('#acct', { y: 0, rotation: 0, scale: 1, duration: 0.9, ease: IO }, 3.2);
      R('#h2t', 3.25, {}, { duration: 0.4 }); R('#h2b', wd(2, 4) - 0.2, { scale: 0.85 }, { scale: 1, duration: 0.6 });
      R('#today', wd(2, 6), POP, POPTO); R('#later', wd(2, 11), POP, POPTO);
      tl.fromTo('#arrow', { opacity: 0 }, { opacity: 1, duration: 0.01, immediateRender: false }, 5.4); tl.to('#arrow', { opacity: 0, duration: 0.01 }, 7.0);
      ['#h2t', '#h2b', '#today', '#later'].forEach((s) => X(s, 7.0, 0.25));
      // ---- L3 poorer (7.21 - 8.9)
      R('#h3t', 7.21, {}, { duration: 0.4 }); R('#h3b', wd(3, 3) - 0.2, { scale: 0.8, y: 40 }, { scale: 1, duration: 0.6 });
      R('#iDown', wd(3, 3), { scale: 0.5, y: 0 }, POPTO); R('#chip3', wd(3, 3) + 0.2, {}, { duration: 0.4 });
      ['#h3t', '#h3b', '#iDown', '#chip3'].forEach((s) => X(s, 9.1, 0.25));
      // ---- L4 strange (9.37 - 10.95)
      R('#k1', 9.37, { scale: 0.85 }, { scale: 1, duration: 0.5 }); R('#k2', wd(4, 1), { scale: 0.85 }, { scale: 1, duration: 0.5 }); R('#iQ', wd(4, 2), { scale: 0.3, y: 0 }, POPTO);
      ['#k1', '#k2', '#iQ'].forEach((s) => X(s, 11.2, 0.25));
      // ---- L5 imagine $100 (11.45 - 14)
      R('#h5t', 11.45, {}, { duration: 0.4 }); R('#h5b', wd(5, 3) - 0.2, { scale: 0.7, y: 40 }, { scale: 1, duration: 0.6 });
      tl.to('#acct', { scale: 1.05, duration: 0.25, ease: E }, wd(5, 3)); tl.to('#acct', { scale: 1, duration: 0.35, ease: IO }, wd(5, 3) + 0.25);
      tl.fromTo('#money', { opacity: 0 }, { opacity: 1, duration: 0.01, immediateRender: false }, 12.45); tl.to('#money', { opacity: 0, duration: 0.01 }, 14.2);
      ['#h5t', '#h5b'].forEach((s) => X(s, 14.2, 0.25));
      // ---- L6 ten meals (14.48 - 17.9)
      R('#h6t', 14.48, {}, { duration: 0.4 }); R('#h6b', wd(6, 6) - 0.25, { scale: 0.8, y: 40 }, { scale: 1, duration: 0.6 });
      for (let i = 0; i < 10; i++) R('#m' + i, wd(6, 4) + i * 0.1, POP, POPTO);
      ['#h6t', '#h6b'].forEach((s) => X(s, 18.2, 0.25));
      // ---- L7 prices rise (18.39 - 24.85)
      R('#h7t', 18.39, {}, { duration: 0.4 }); R('#h7b', wd(7, 6) - 0.2, { scale: 0.85 }, { scale: 1, duration: 0.6 });
      X('#h7t', 21.3, 0.2); X('#h7b', 21.3, 0.2);
      R('#ptag', wd(7, 8), {}, { duration: 0.4 });
      R('#h7ct', 21.3, {}, { duration: 0.35 }); R('#h7cb', wd(7, 13) - 0.2, { scale: 0.7, y: 40 }, { scale: 1, duration: 0.6 });
      const PV = { v: 100 }; tl.to(PV, { v: 120, duration: 0.7, ease: 'power3.out', onUpdate() { $('#pv').textContent = fmt(PV.v); } }, wd(7, 13));
      ['#h7ct', '#h7cb', '#ptag'].forEach((s) => X(s, 25.1, 0.25)); for (let i = 0; i < 10; i++) X('#m' + i, 25.1, 0.25);
      // ---- L8 didn't disappear (25.35 - 27.85)
      R('#h8t', 25.35, {}, { duration: 0.4 }); R('#h8b', wd(8, 2) - 0.1, { scale: 0.85 }, { scale: 1, duration: 0.6 });
      R('#iOk', wd(8, 3) - 0.2, { scale: 0.5, y: 0 }, POPTO); R('#chip8', wd(8, 3), {}, { duration: 0.4 });
      ['#h8t', '#h8b', '#iOk', '#chip8'].forEach((s) => X(s, 28.05, 0.2));
      // ---- L9 nobody took (28.25 - 30.45)
      R('#h9t', 28.25, {}, { duration: 0.4 }); R('#h9b', wd(9, 2) - 0.2, { scale: 0.85 }, { scale: 1, duration: 0.6 });
      R('#iNo', wd(9, 2), { scale: 0.5, y: 0 }, POPTO); R('#chip9', wd(9, 5), {}, { duration: 0.4 });
      ['#h9t', '#h9b', '#iNo', '#chip9'].forEach((s) => X(s, 30.65, 0.2));
      // ---- L10 buys less (30.85 - 33.2)
      R('#h10t', 30.85, {}, { duration: 0.4 }); R('#h10b', wd(10, 4) - 0.2, { scale: 0.8, y: 40 }, { scale: 1, duration: 0.6 });
      for (let i = 0; i < 10; i++) R('#m' + i, wd(10, 1) + i * 0.04, POP, POPTO);
      [8, 9].forEach((i) => tl.to('#m' + i, { opacity: 0.14, scale: 0.9, duration: 0.5, ease: 'power2.inOut' }, wd(10, 4) + 0.1 + (i - 8) * 0.2));
      R('#chip10', wd(10, 4) + 0.5, {}, { duration: 0.4 });
      ['#h10t', '#h10b', '#chip10', '#acct'].forEach((s) => X(s, 33.45, 0.25)); for (let i = 0; i < 10; i++) X('#m' + i, 33.45, 0.25);
      // ---- L11 inflation (33.67 - 35.4)
      R('#h11t', 33.67, {}, { duration: 0.4 }); R('#h11b', wd(11, 3) - 0.3, { scale: 0.75, y: 40 }, { scale: 1, duration: 0.6 });
      R('#iUp', wd(11, 3), { scale: 0.5, y: 0 }, POPTO); R('#chip11', wd(11, 4), {}, { duration: 0.4 });
      ['#h11t', '#h11b', '#iUp', '#chip11'].forEach((s) => X(s, 35.65, 0.2));
      // ---- L12 purchasing power (35.9 - 40.45)
      R('#h12t', 35.9, {}, { duration: 0.4 }); R('#h12b', wd(12, 5) - 0.15, { scale: 0.85 }, { scale: 1, duration: 0.6 });
      R('#chart', 36.0, { y: 40 }, { duration: 0.6 }); tl.fromTo('#cline', { strokeDashoffset: 700 }, { strokeDashoffset: 0, duration: 2.2, ease: 'power1.inOut', immediateRender: false }, wd(12, 1));
      R('#coinc', wd(12, 5), { y: 40 }, { duration: 0.6 });
      tl.to('#coin', { scale: 0.55, duration: 1.3, ease: IO }, wd(12, 8));
      ['#h12t', '#h12b', '#chart', '#coinc'].forEach((s) => X(s, 40.65, 0.25));
      // ---- L13 more money (40.94 - 44.66)
      R('#h13t', 40.94, {}, { duration: 0.4 }); R('#h13b', wd(13, 3) - 0.1, { scale: 0.85 }, { scale: 1, duration: 0.6 }); STRIKE('#h13s', wd(13, 9) - 0.05);
      R('#acct2', 41.1, { y: 50 }, { duration: 0.6 });
      const AB = { v: 100 }; tl.to(AB, { v: 120, duration: 0.7, ease: 'power3.out', onUpdate() { $('#acct2b').textContent = fmt(AB.v); } }, wd(13, 2)); tl.fromTo('#acct2b', { color: '#111' }, { color: '#1e2bfa', duration: 0.3, immediateRender: false }, wd(13, 2));
      ['#h13t', '#h13b', '#acct2'].forEach((s) => X(s, 44.9, 0.25));
      // ---- L14 what it buys (45.16 - 48.8)
      R('#h14t', 45.16, {}, { duration: 0.4 }); R('#h14b', wd(14, 3) + 0.2, { scale: 0.85 }, { scale: 1, duration: 0.6 });
      [wd(14, 6), wd(14, 7), wd(14, 8), wd(14, 9)].forEach((t, i) => R('#sh' + i, t - 0.1, POP, POPTO));
      ['#h14t', '#h14b', '#sh0', '#sh1', '#sh2', '#sh3'].forEach((s) => X(s, 49.0, 0.25));
      // ---- L15 eaten away (49.24 - 54)
      R('#h15t', 49.24, {}, { duration: 0.4 }); R('#h15b', wd(15, 4) - 0.1, { scale: 0.85 }, { scale: 1, duration: 0.6 });
      R('#donut', wd(15, 5) - 0.2, { scale: 0.7, y: 40 }, { scale: 1, duration: 0.6 }); R('#chip15', wd(15, 9), {}, { duration: 0.4 });
      const DN = { v: 100 }; tl.to(DN, { v: 66, duration: 1.8, ease: IO, onUpdate() { $('#donut').style.background = `conic-gradient(#1e2bfa 0 ${DN.v}%, rgba(30,43,250,0.12) ${DN.v}% 100%)`; } }, wd(15, 6));
      ['#h15t', '#h15b', '#donut', '#chip15'].forEach((s) => X(s, 54.3, 0.25));
      // ---- L16 / L17 balance vs buying power (54.57 - 59.5)
      R('#h16t', 54.57, {}, { duration: 0.4 }); R('#h16b', wd(16, 4) - 0.2, { scale: 0.85 }, { scale: 1, duration: 0.6 });
      R('#bl1', 54.8, {}, { duration: 0.4 }); R('#bb1', 54.9, { y: 0, scaleX: 0, transformOrigin: 'left center' }, { scaleX: 1, duration: 0.7, ease: IO });
      R('#bl2', 55.6, {}, { duration: 0.4 }); R('#bb2', 55.7, { y: 0 }, { duration: 0.5 });
      X('#h16t', 57.2, 0.2); X('#h16b', 57.2, 0.2);
      R('#h17t', 57.37, {}, { duration: 0.4 }); R('#h17b', wd(17, 4) - 0.1, { scale: 0.85 }, { scale: 1, duration: 0.6 });
      tl.to('#bb2', { width: 470, duration: 1.2, ease: IO }, wd(17, 4));
      ['#h17t', '#h17b', '#bl1', '#bb1', '#bl2', '#bb2'].forEach((s) => X(s, 59.8, 0.25));
      // ---- L18 final (60.08 - 61.9)
      R('#f1', 60.08, {}, { duration: 0.6 }); R('#f2', 60.76, { scale: 0.85, y: 40 }, { scale: 1, duration: 0.6 });

      // ---- Lotties (time-shifted copies; see scripts/lottie_shift.mjs)
      const mk = (id, path) => { const a = lottie.loadAnimation({ container: document.getElementById(id), renderer: 'svg', loop: false, autoplay: false, path, rendererSettings: { preserveAspectRatio: 'xMidYMid meet' } }); (window.__hfLottie = window.__hfLottie || []).push(a); return a; };
      mk('money', 'assets/lottie/money-s.json'); mk('arrow', 'assets/lottie/arrow-s.json'); mk('conf', 'assets/lottie/confetti-s.json');
      tl.fromTo('#conf', { opacity: 0 }, { opacity: 1, duration: 0.01, immediateRender: false }, 61.2); tl.to('#conf', { opacity: 0, duration: 0.01 }, 63.4);
      // sparkles on the success moments
      [[12.7, 540, 640], [34.8, 540, 640], [61.3, 540, 420]].forEach(([t0, cx, cy]) => { for (let i = 0; i < 6; i++) { const a = i / 6 * 6.283, s = document.createElement('div'); s.className = 'spark'; s.style.left = (cx - 45 + Math.cos(a) * 300) + 'px'; s.style.top = (cy - 45 + Math.sin(a) * 140) + 'px'; s.style.backgroundColor = i % 2 ? '#1e2bfa' : '#f6b73c'; $('#stage').appendChild(s);
        tl.fromTo(s, { opacity: 0, scale: 0.2, rotation: -40 }, { opacity: 1, scale: 0.6 + (i % 3) * 0.2, rotation: 20, duration: 0.4, ease: E, immediateRender: false }, t0 + i * 0.05); tl.to(s, { opacity: 0, scale: 0.1, duration: 0.5, ease: 'power2.in' }, t0 + 0.9 + i * 0.04); } });
      tl.fromTo('#root', { backgroundPosition: '0px 0px' }, { backgroundPosition: '-120px -240px', duration: __TOTAL__, ease: 'none', immediateRender: false }, 0);

      // ---------- captions ----------
      const capsEl = $('#caps');
      const groups = []; let cur = [];
      WORDS.forEach((w, i) => { cur.push(w); const nx = WORDS[i + 1]; const endS = /[.!?…]$/.test(w.w); const endC = /,$/.test(w.w) && cur.length >= 3; if (!nx || endS || endC || cur.length >= 5 || (nx && nx.s - w.e > 0.5)) { groups.push(cur); cur = []; } });
      groups.forEach((g, gi) => {
        if (g[0].line === 18) return;
        const d = document.createElement('div'); d.className = 'cg'; const pill = document.createElement('div'); pill.className = 'pill'; d.appendChild(pill);
        g.forEach((w, wi) => { const s = document.createElement('span'); s.className = 'cw'; s.id = `cw${gi}_${wi}`; s.textContent = w.w; pill.appendChild(s); });
        capsEl.appendChild(d);
        const a = g[0].s - 0.03, nextS = groups[gi + 1] ? groups[gi + 1][0].s : 1e9, b = Math.min(g[g.length - 1].e + 0.25, nextS - 0.12);
        tl.fromTo(d, { opacity: 0, y: 14 }, { opacity: 1, y: 0, duration: 0.12, ease: 'power2.out', immediateRender: false }, a);
        tl.to(d, { opacity: 0, duration: 0.08, ease: 'none' }, b);
        g.forEach((w, wi) => { const sp = `#cw${gi}_${wi}`;
          tl.fromTo(sp, { backgroundColor: 'rgba(30,43,250,0)', color: '#111' }, { backgroundColor: '#1e2bfa', color: '#fdfae7', duration: 0.07, ease: 'none', immediateRender: false }, w.s);
          tl.to(sp, { backgroundColor: 'rgba(30,43,250,0)', color: '#111', duration: 0.08, ease: 'none' }, Math.max(w.e, w.s + 0.12)); });
      });
      tl.fromTo('#prog', { scaleX: 0 }, { scaleX: 1, duration: __TOTAL__, ease: 'none', immediateRender: false }, 0);
      window.__timelines['main'] = tl;
      tl.seek(0);
    </script>
  </body>
</html>
